{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/node/bin\" node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/node/bin\" node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-end.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/node/bin\" node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-end.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PATH=\"$PATH:$HOME/.local/node/bin\" node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
